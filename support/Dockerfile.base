ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ARG HOST_UID=1000
ARG HOST_GID=1000

RUN echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/99-sandbox

RUN apt update && apt install -y \
  curl \
  git \
  python3 \
  sudo \
  && apt clean && rm -rf /var/lib/apt/lists/*

# Create a 'claude' user with the host UID/GID at build time.
# Ubuntu 24.04 ships with an 'ubuntu' user at UID 1000; handle that conflict
# by renaming it or creating fresh depending on what the base image has.
RUN set -e; \
    EXISTING_USER=$(getent passwd "${HOST_UID}" | cut -d: -f1 || true); \
    EXISTING_GROUP=$(getent group "${HOST_GID}" | cut -d: -f1 || true); \
    if [ -n "$EXISTING_GROUP" ] && [ "$EXISTING_GROUP" != "claude" ]; then \
        groupmod -n claude "$EXISTING_GROUP"; \
    elif [ -z "$EXISTING_GROUP" ]; then \
        groupadd -g "${HOST_GID}" claude; \
    fi; \
    if [ -n "$EXISTING_USER" ] && [ "$EXISTING_USER" != "claude" ]; then \
        usermod -l claude -d /home/claude -m -g "${HOST_GID}" "$EXISTING_USER"; \
    elif [ -z "$EXISTING_USER" ]; then \
        useradd -m -u "${HOST_UID}" -g "${HOST_GID}" -s /bin/bash claude; \
    fi; \
    echo "claude ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/claude; \
    chmod 0440 /etc/sudoers.d/claude

RUN mkdir -p /workspace /claudespaces /claudespaces/bin
WORKDIR /workspace

COPY bin/entrypoint.sh /claudespaces/entrypoint.sh
COPY bin/claudespaces-host /claudespaces/bin/claudespaces-host
COPY CLAUDE.md /workspace/CLAUDE.md

RUN chmod +x /claudespaces/entrypoint.sh /claudespaces/bin/claudespaces-host

# Install Claude as the claude user so it lands in /home/claude/.local/bin
# (the install script uses XDG paths that resolve to the real user's home,
# so we can't just HOME-override as root).
USER claude
RUN curl -fsSL https://claude.ai/install.sh | bash

ENTRYPOINT ["sleep", "infinity"]
