ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

RUN echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/99-sandbox

RUN apt update && apt install -y \
  curl \
  && apt clean && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://claude.ai/install.sh | bash

RUN mkdir -p /workspace /claudespaces
WORKDIR /workspace

COPY claudespaces/support/bin/entrypoint.sh /claudespaces/entrypoint.sh

ENTRYPOINT ["/claudespaces/entrypoint.sh"]
